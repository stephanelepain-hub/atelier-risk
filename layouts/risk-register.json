      "likelihood": ["Likelihood", "Current likelihood", "Vraisemblance", "Vraisemblance actuelle"],
      "likelihood_target": ["Target likelihood", "Residual likelihood", "Vraisemblance cible", "Vraisemblance residuelle"],
      "level_now": ["Risk level", "Level", "Current level", "Niveau de risque", "Niveau"],
      "level_target": ["Target level", "Residual level", "Niveau cible", "Niveau residuel"],
      "treatment": ["Treatment", "Traitement"],
      "owner": ["Owner", "Risk owner", "Proprietaire", "Responsable"],
